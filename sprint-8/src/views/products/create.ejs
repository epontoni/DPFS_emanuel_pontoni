<%- include('../partials/head', { title: 'Create Product' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container" style="max-width: 640px; margin: 2rem auto;">
    <h1 class="page-title">Create Product</h1>
    
    <form action="/products" method="POST" style="margin-top: 1.5rem;" novalidate>
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Nombre del producto</label>
        <input
          name="name"
          class="input"
          value="<%= locals.oldData && oldData.name ? oldData.name : '' %>"
          placeholder="Ej: Bicicleta urbana"
          style="width: 100%; padding: 8px;"
        />
        <% if (locals.errors && errors.name) { %>
          <div style="color: #FF3B30; font-size: 0.85rem; margin-top: 4px;"><%= errors.name.msg %></div>
        <% } %>
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Descripción</label>
        <textarea
          name="description"
          class="input"
          placeholder="Describe el producto..."
          style="width: 100%; padding: 8px; height: 100px;"
        ><%= locals.oldData && oldData.description ? oldData.description : '' %></textarea>
        <% if (locals.errors && errors.description) { %>
          <div style="color: #FF3B30; font-size: 0.85rem; margin-top: 4px;"><%= errors.description.msg %></div>
        <% } %>
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Imagen (URL)</label>
        <input
          name="image"
          class="input"
          value="<%= locals.oldData && oldData.image ? oldData.image : '' %>"
          placeholder="Ej: https://example.com/image.jpg"
          type="url"
          style="width: 100%; padding: 8px;"
        />
        <% if (locals.errors && errors.image) { %>
          <div style="color: #FF3B30; font-size: 0.85rem; margin-top: 4px;"><%= errors.image.msg %></div>
        <% } %>
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Categoría</label>
        <input
          name="category"
          class="input"
          value="<%= locals.oldData && oldData.category ? oldData.category : '' %>"
          placeholder="Ej: Bikes, Accesorios"
          style="width: 100%; padding: 8px;"
        />
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Colores (separados por coma)</label>
        <input
          name="colors"
          class="input"
          value="<%= locals.oldData && oldData.colors ? oldData.colors : '' %>"
          placeholder="Ej: Rojo, Azul, Negro"
          style="width: 100%; padding: 8px;"
        />
      </div>
      
      <div class="form-row" style="margin-bottom: 1.5rem;">
        <label class="form-label">Precio</label>
        <input
          name="price"
          class="input"
          value="<%= locals.oldData && oldData.price ? oldData.price : '' %>"
          placeholder="0.00"
          type="number"
          step="0.01"
          style="width: 100%; padding: 8px;"
        />
      </div>
      
      <div style="margin-top: 1.5rem">
        <button class="btn btn-primary" type="submit" style="padding: 10px 20px;">Create</button>
      </div>
    </form>
  </div>
</main>

<script src="/public/js/productValidation.js"></script>
<%- include('../partials/footer') %>
