    <header class="site-header">
      <div class="header-inner container">
        <a href="/" class="brand" style="text-decoration: none; color: inherit">
          <svg
            fill="none"
            height="40"
            viewBox="0 0 48 48"
            width="40"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M41.0625 24C41.0625 33.4264 33.4264 41.0625 24 41.0625C14.5736 41.0625 6.9375 33.4264 6.9375 24C6.9375 14.5736 14.5736 6.9375 24 6.9375C33.4264 6.9375 41.0625 14.5736 41.0625 24Z"
              stroke="#0A84FF"
              stroke-miterlimit="10"
              stroke-width="4"
            ></path>
          </svg>
          <div>
            <div class="title">MAKERHUB</div>
            <div class="subtitle">BUILD • INNOVATE • CREATE</div>
          </div>
        </a>

        <nav class="main-nav">
          <a href="/products"><%= __('nav_products') %></a>
          <a href="#"><%= __('nav_kits') %></a>
          <a href="#"><%= __('nav_community') %></a>
          <% if (user && user.role === 'admin') { %>
            <a href="/products/create" style="color: #0A84FF"><%= __('nav_create_product') %></a>
            <a href="/users" style="color: #BF5AF2"><%= __('nav_manage_users') %></a>
          <% } %>
        </nav>

        <div class="header-actions">
          <% if (user) { %>
          <a
            href="/users/profile"
            class="user-link"
            style="display: flex; align-items: center; gap: 8px"
          >
            <% if (user.image) { %>
            <img
              src="<%= user.image %>"
              alt="avatar"
              style="
                width: 32px;
                height: 32px;
                border-radius: 6px;
                object-fit: cover;
              "
            />
            <% } else { %>
            <span class="material-icons">person</span>
            <% } %>
            <span><%= user.firstName %></span>
          </a>
          <a href="/logout" class="icon-btn" title="Cerrar sesión">
            <span class="material-icons">logout</span></a
          >
          <% } else { %>
          <a href="/login" class="icon-btn"
            ><span class="material-icons">person_outline</span></a
          >
          <% } %>
          <a href="/shopping-cart" class="icon-btn"
            ><span class="material-icons">shopping_bag</span></a
          >
          
          <div class="lang-selector" style="margin-left: 12px; display: inline-flex; gap: 6px; font-size: 0.8rem; font-weight: bold; align-items: center;">
            <a href="?lang=es" style="color: <%= locals.lang === 'es' ? '#0A84FF' : '#9ca3af' %>; text-decoration: none;">ES</a>
            <span style="color: #4b5563;">|</span>
            <a href="?lang=en" style="color: <%= locals.lang === 'en' ? '#0A84FF' : '#9ca3af' %>; text-decoration: none;">EN</a>
          </div>
        </div>
      </div>
    </header>
