<%- include('../partials/head', { title: 'Login' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="container" style="max-width: 400px; margin: 3rem auto;">
    <h1>Iniciar sesión</h1>
    
    <form action="/login" method="POST" style="margin-top: 1.5rem;" novalidate>
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="input" value="<%= locals.oldData && oldData.email ? oldData.email : '' %>" style="width: 100%; padding: 8px;" />
        <% if (locals.errors && errors.email) { %>
          <div style="color: #FF3B30; font-size: 0.85rem; margin-top: 4px;"><%= errors.email.msg %></div>
        <% } %>
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="form-label">Contraseña</label>
        <input name="password" type="password" class="input" style="width: 100%; padding: 8px;" />
        <% if (locals.errors && errors.password) { %>
          <div style="color: #FF3B30; font-size: 0.85rem; margin-top: 4px;"><%= errors.password.msg %></div>
        <% } %>
      </div>
      
      <div class="form-row" style="margin-bottom: 1rem;">
        <label class="checkbox">
          <input name="remember" type="checkbox" /> Recordarme
        </label>
      </div>
      
      <div style="margin-top: 1.5rem">
        <button class="btn btn-primary" type="submit" style="width: 100%; padding: 10px;">Entrar</button>
      </div>
      
      <div style="margin-top: 1rem; text-align: center;">
        <a href="/register" class="link">Crear cuenta</a>
      </div>
    </form>
  </div>
</main>

<script src="/public/js/loginValidation.js"></script>
<%- include('../partials/footer') %>
